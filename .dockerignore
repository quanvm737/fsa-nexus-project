# ============================================================
#  .dockerignore — Danh sách file BỊ LOẠI TRỪ khỏi Docker Build
# ============================================================
#
# ❓ FILE NÀY LÀM GÌ?
# --------------------
# Khi chạy `docker build`, Docker copy toàn bộ thư mục hiện tại
# vào "build context" để xử lý. .dockerignore giống như .gitignore
# nhưng dành cho Docker — nó loại trừ các file/thư mục không cần thiết.
#
# ✅ TẠI SAO QUAN TRỌNG:
#  - node_modules có thể nặng hàng GB → build rất chậm nếu không exclude
#  - .env.local chứa secrets → KHÔNG được đưa vào image
#  - .git không cần thiết trong production image
#  - Build time giảm từ vài phút xuống còn vài chục giây
#
# ============================================================

# Dependencies (sẽ được cài lại bên trong container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output (sẽ được build bên trong container)
.next
out

# Environment files (KHÔNG BAO GIỜ đưa secrets vào Docker image!)
.env.local
.env.*.local
.env.development
.env.test

# Version control
.git
.gitignore

# Development tools
.editorconfig
.eslintcache

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode
.idea
*.swp
*.swo

# Test files (không cần trong production)
tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Docs (không cần trong production)
docs
README.md
